{
  "type": "object",
  "properties": {
    "record_kind": {
      "const": "run"
    },
    "schema_version": {
      "const": 1
    },
    "record_context": {
      "enum": [
        "research",
        "fixture",
        "runtime"
      ]
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "maxLength": 96
    },
    "disclosure": {
      "$ref": "https://pear.invalid/contracts/v1/common.schema.json#/$defs/disclosure"
    },
    "request": {
      "anyOf": [
        {
          "$ref": "https://pear.invalid/contracts/v1/common.schema.json#/$defs/record_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
      "maxLength": 96
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "https://pear.invalid/contracts/v1/common.schema.json#/$defs/record_ref"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "https://pear.invalid/contracts/v1/common.schema.json#/$defs/record_ref"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "configuration": {
      "$ref": "https://pear.invalid/contracts/v1/common.schema.json#/$defs/configuration"
    },
    "started_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "identity": {
            "$ref": "https://pear.invalid/contracts/v1/common.schema.json#/$defs/process_identity"
          },
          "purpose": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
            "maxLength": 96
          },
          "required": {
            "type": "boolean"
          },
          "observed": {
            "type": "boolean"
          },
          "host_architecture": {
            "enum": [
              "arm64",
              "x86_64",
              "unknown"
            ]
          },
          "translated": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "module_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
                  "maxLength": 96
                },
                "kind": {
                  "enum": [
                    "host",
                    "guest"
                  ]
                },
                "architecture": {
                  "enum": [
                    "arm64",
                    "arm64ec",
                    "x86_64",
                    "i386",
                    "unknown"
                  ]
                },
                "observed": {
                  "type": "boolean"
                },
                "source": {
                  "enum": [
                    "artifact",
                    "system",
                    "game"
                  ]
                },
                "artifact_file_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
                      "maxLength": 96
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "observed_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "maxLength": 64
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "$ref": "https://pear.invalid/contracts/v1/common.schema.json#/$defs/blob_ref"
                  },
                  "minItems": 0,
                  "maxItems": 64
                },
                "content": {
                  "anyOf": [
                    {
                      "$ref": "https://pear.invalid/contracts/v1/common.schema.json#/$defs/blob_ref"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "module_id",
                "kind",
                "architecture",
                "observed",
                "source",
                "artifact_file_id",
                "observed_sha256",
                "evidence",
                "content"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 64
          }
        },
        "required": [
          "identity",
          "purpose",
          "required",
          "observed",
          "host_architecture",
          "translated",
          "modules"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "unknown",
            "unsupported"
          ]
        },
        "required_processes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
            "maxLength": 96
          },
          "minItems": 0,
          "maxItems": 64
        },
        "missing_processes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
            "maxLength": 96
          },
          "minItems": 0,
          "maxItems": 64
        },
        "missing_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$",
            "maxLength": 96
          },
          "minItems": 0,
          "maxItems": 64
        },
        "dropped_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "status",
        "required_processes",
        "missing_processes",
        "missing_modules",
        "dropped_events"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "https://pear.invalid/contracts/v1/common.schema.json#/$defs/check"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "exit": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "exited",
            "signaled",
            "timeout",
            "unknown"
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 127
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanup": {
          "enum": [
            "passed",
            "failed",
            "unknown",
            "unsupported"
          ]
        }
      },
      "required": [
        "kind",
        "code",
        "signal",
        "cleanup"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "record_kind",
    "schema_version",
    "record_context",
    "record_id",
    "disclosure",
    "request",
    "run_id",
    "events",
    "failures",
    "configuration",
    "started_at",
    "processes",
    "coverage",
    "checks",
    "exit"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pear.invalid/contracts/v1/run.schema.json"
}
